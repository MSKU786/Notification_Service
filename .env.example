# Server
PORT=3000

# Email channel
# provider: mock | ses | sendgrid
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.com
EMAIL_API_KEY=

# SMS channel
# provider: mock | twilio
SMS_PROVIDER=mock
SMS_FROM=+15550000000
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=

# Slack channel
SLACK_TOKEN=
SLACK_DEFAULT_CHANNEL=#general

# Queue retry policy
# Total attempts before a job is marked failed (>=1; 1 disables retries)
QUEUE_MAX_ATTEMPTS=3
# First retry delay in ms, doubled each attempt (exponential backoff)
QUEUE_BASE_DELAY_MS=500
# Ceiling for the backoff delay in ms
QUEUE_MAX_DELAY_MS=30000
# Persistence backend: memory (default, lost on restart) | file (survives restart)
QUEUE_STORE=memory
# Path to the JSON job file when QUEUE_STORE=file
QUEUE_FILE=data/jobs.json
